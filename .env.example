APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Microsoft Entra OIDC — desktop SSO voor admin/employee. Contract: docs/FEATURES.md §6.4
# Knop op /login alleen als CLIENT_ID + SECRET gezet zijn. Geen secret in git.
# Omleidings-URI’s in Azure (Verificatie → Web), exact hetzelfde als de app gebruikt:
#   productie: https://winprox.app/auth/microsoft/callback
#   lokaal:    http://localhost/auth/microsoft/callback
# Azure staat http alleen toe voor hostnaam localhost (niet 127.0.0.1).
# APP_URL lokaal = http://localhost zodat de callback matcht.
# Account types: any organizational directory (multitenant), geen persoonlijke MSA.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT=organizations
# Niet `common`: die endpoint is ook voor Hotmail/Xbox → Azure: unauthorized_client
# (app is niet enabled for consumers).
# ENTRA_REDIRECT_URI=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.cloud86.com
MAIL_PORT=587
MAIL_USERNAME=info@winprox.app
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM_ADDRESS="info@winprox.app"
MAIL_FROM_NAME="WinProx Support"

WINPROX_MUNICIPAL_PROMO_EMAIL_FROM="dominique.schaepdrijver@winprox.app"
WINPROX_MUNICIPAL_PROMO_EMAIL_FROM_NAME="Dominique Schaepdrijver"
# Promo-campagnes via Amazon SES (niet Cloud86). Fallback: municipal_promo
WINPROX_PROMO_MAILER=ses
# Min. interval tussen bulk-mails. SES: 1. Cloud86 SMTP: 20 (~250/uur).
WINPROX_PROMO_EMAIL_MIN_INTERVAL_SECONDS=1
# Emergency kill switch: false = geen bulk promo-mails (wachtende jobs slaan over).
WINPROX_PROMO_EMAILS_ENABLED=true
# MX-check bij promo-import (false = sla DNS over; tests zetten dit uit).
WINPROX_PROMO_EMAIL_PREFLIGHT_DNS=true
# SES configuration set (bounces/complaints via SNS). Leeg = geen extra SES-tags.
# AWS_SES_CONFIGURATION_SET=winprox-promo
# Token voor POST /api/v1/hooks/ses-promo?token=...
# WINPROX_SES_SNS_TOKEN=

# IMAP Configuration for fetching email replies
IMAP_HOST=mail.cloud86.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=info@winprox.app
IMAP_PASSWORD=your_imap_password_here
IMAP_PROTOCOL=imap
IMAP_AUTHENTICATION=null

# Promo bounce mailbox (defaults to Dominique / MAIL_PASSWORD if unset)
# WINPROX_PROMO_IMAP_USERNAME=dominique.schaepdrijver@winprox.app
# WINPROX_PROMO_IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe — WinProx jaarformules (+ Time-prikklok-variant). Corporate = handmatig via platform.
# Maak in Stripe Dashboard yearly recurring prices aan en plak de price_… IDs hier.
# STRIPE_SECRET=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_WINPROX_10=price_…
# STRIPE_PRICE_WINPROX_10_TIME=price_…
# STRIPE_PRICE_WINPROX_50=price_…
# STRIPE_PRICE_WINPROX_50_TIME=price_…
# STRIPE_PRICE_WINPROX_100=price_…
# STRIPE_PRICE_WINPROX_100_TIME=price_…
# Legacy maandtiers (bestaande abonnees):
# STRIPE_PRICE_FACILITY_10=price_…
# STRIPE_PRICE_FACILITY_25=price_…
# STRIPE_PRICE_FACILITY_50=price_…
# STRIPE_PRICE_FACILITY_100=price_…
# STRIPE_PRICE_FACILITY_250=price_…
# STRIPE_PRICE_FACILITY_500=price_…
# STRIPE_PRICE_FACILITY_1000=price_…
# STRIPE_SUCCESS_PATH=/subscription
# STRIPE_CANCEL_PATH=/subscription

# Billing (optioneel)
# BILLING_TRIAL_DAYS=30
# BILLING_PAID_GRACE_DAYS=7
# BILLING_ALLOW_SELF_ACTIVATION=true
# BILLING_SUBSCRIPTION_PERIOD_DAYS=30
# BILLING_CONTACT_EMAIL=info@winprox.app

# Handleiding-screenshots — zie docs/MANUAL_SCREENSHOTS.md (golden path: scripts/capture-manual-local.ps1)
# Plesk shared: capture lokaal op Windows; committen public/images/manual/**/*.png
# Plesk zonder node in PATH: MANUAL_CAPTURE_NODE_BIN=/opt/plesk/node/24/bin/node
# MANUAL_CAPTURE_NODE_BIN=node
# Chromium in project (upload/rsync na install op PC): storage/playwright-browsers
# MANUAL_CAPTURE_PLAYWRIGHT_BROWSERS_PATH=/var/www/vhosts/.../storage/playwright-browsers
# Shared hosting: headless_shell (~90MB) i.p.v. volledige chrome; zie scripts/capture-manual-local.ps1
# MANUAL_CAPTURE_CHROME_LOW_RESOURCE=true
# Lokaal tegen productie: MANUAL_CAPTURE_BASE_URL=https://winprox.app (geen HOST nodig)
MANUAL_CAPTURE_BASE_URL=http://127.0.0.1
# MANUAL_CAPTURE_HOST=winprox.app
MANUAL_CAPTURE_EMAIL=
MANUAL_CAPTURE_PASSWORD=
# MANUAL_CAPTURE_TIMEOUT=600
# IDs/tokens van je handleiding-tenant (stabiele demo-data):
# MANUAL_CAPTURE_LOCATION_ID=
# MANUAL_CAPTURE_ISSUE_ID=
# MANUAL_CAPTURE_TASK_ID=
# MANUAL_CAPTURE_UNIT_QR_TOKEN=
# MANUAL_CAPTURE_CLOCK_POINT_TOKEN=
# Teamleader/worker voor QR-portaalshots (optioneel):
# MANUAL_CAPTURE_WORKER_FIRST_NAME=
# MANUAL_CAPTURE_WORKER_LAST_NAME=
# MANUAL_CAPTURE_WORKER_ICON=heart

# Ollama — lokale vertaling van melding-omschrijvingen (winprox:translate-issues)
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT=60
# OLLAMA_TRANSLATION_BATCH_LIMIT=25

# Vertaling-sync lokaal → productieserver (superuser Platform → Vertalingen)
# TRANSLATION_SYNC_ENABLED=true
# TRANSLATION_SYNC_SSH_HOST=winprox.app
# TRANSLATION_SYNC_SSH_USER=
# TRANSLATION_SYNC_SSH_PORT=22
# TRANSLATION_SYNC_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# TRANSLATION_SYNC_REMOTE_PATH=/var/www/vhosts/example.com/httpdocs/winprox
# Plesk: volledig pad naar php (which php op de server), bv. /opt/plesk/php/8.3/bin/php
# TRANSLATION_SYNC_REMOTE_PHP=/opt/plesk/php/8.3/bin/php
# TRANSLATION_SYNC_TIMEOUT=7200
# Aantal vertalingen per reeks: elke reeks wordt apart geïmporteerd op de server
# TRANSLATION_SYNC_BATCH_SIZE=50

# Publiek QR-portaal — rate limit burger-meldingen (zie config/portal.php)
# PORTAL_REPORT_RATE_LIMIT_ENABLED=true
# PORTAL_REPORT_RATE_LIMIT_COOLDOWN=180         # cooldown tussen 2 meldingen (sec); 0 = uit
# PORTAL_REPORT_RATE_LIMIT_PER_UNIT=5           # max meldingen per unit+IP binnen venster
# PORTAL_REPORT_RATE_LIMIT_PER_UNIT_DECAY=1800  # venster per unit+IP (sec) = 30 min
# PORTAL_REPORT_RATE_LIMIT_PER_TENANT=20
# PORTAL_REPORT_RATE_LIMIT_PER_TENANT_DECAY=3600

# IndexNow (Bing e.a.) — key file: public/{INDEXNOW_KEY}.txt
# INDEXNOW_ENABLED=true
# INDEXNOW_KEY=2c081d71a6a943a19a81fbb727f93cf4
# INDEXNOW_HOST=winprox.app
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
